{
  "name": "nexora-app",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "npm install && npm --prefix frontend install",
    "dev": "concurrently -n backend,frontend -c blue,green \"node scripts/backend.mjs\" \"npm --prefix frontend run dev\"",
    "backend": "node scripts/backend.mjs",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": { "concurrently": "9.1.0" }
}
